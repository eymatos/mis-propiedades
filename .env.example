# Copia este archivo como .env.local para trabajar en tu computadora.
# En Vercel, estas variables van en Settings > Environment Variables.

# Contraseña para entrar a la app (elige una larga y que solo tú sepas)
APP_PASSWORD=escribe-aqui-tu-contraseña

# Se agregan solas al conectar Neon y Vercel Blob desde la pestaña Storage de Vercel
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Opcionales
# CRON_SECRET=texto-aleatorio      # protege la tarea diaria con una clave
# AUTH_SECRET=texto-aleatorio-32+  # clave propia para firmar la sesión
# APP_URL=https://mis-propiedades.vercel.app
