# Copia este archivo como .env.local para trabajar en tu computadora.
# En Vercel, estas mismas variables se agregan en Settings > Environment Variables.

# Base de datos Neon (Postgres). Si conectas Neon desde Vercel se agrega sola.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Credenciales OAuth de Google Cloud (tipo "Aplicación web")
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Correo(s) de Google con permiso para entrar, separados por coma
ALLOWED_EMAILS=tucorreo@gmail.com

# Clave secreta larga y aleatoria (mínimo 32 caracteres) para firmar la sesión
AUTH_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32+

# Clave para proteger la tarea diaria automática (cualquier texto aleatorio)
CRON_SECRET=otra-clave-aleatoria

# Opcional: URL pública de la app (si no se pone, se detecta sola)
# APP_URL=https://mis-propiedades.vercel.app
